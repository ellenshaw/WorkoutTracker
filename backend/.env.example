# Required: your Anthropic API key (console.anthropic.com). Never put this in the iOS app.
ANTHROPIC_API_KEY=

# Required in production: a long random string. The app sends it in the x-app-key header.
# Generate one with:  openssl rand -hex 32
APP_KEY=

# Optional: which Claude model answers. Defaults to claude-opus-5-5.
# Cheaper options: claude-sonnet-5-5, claude-haiku-5-5.
MODEL=claude-opus-5-5

# Optional: usage limits (per install per hour / per day, per IP per hour).
LIMIT_PER_INSTALL_HOUR=12
LIMIT_PER_INSTALL_DAY=60
LIMIT_PER_IP_HOUR=120

# Optional: port (most hosts set this for you).
PORT=8787
